#!/usr/bin/env bash
# asdf -> mise shim. Work CLI hardcodes `asdf` calls in installers, no mise backend. mise reads `.tool-versions`,
# shares asdf's verb names: everything passes through except `plugin`. Forwarding that installs *asdf* plugin for
# node/ruby, shadowing mise's faster core backends.
case "${1-}" in plugin | plugins) exit 0 ;; esac
exec mise "$@"
