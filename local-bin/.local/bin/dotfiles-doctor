#!/usr/bin/env bash
# Health check for this dotfiles repo: stow state, packages, mise tools, external installs, machine-local files.
# Read-only by default. --fix runs the safe repairs (never resolves a stow conflict, that needs eyes on the file).
# Runs before stow too: ~/dotfiles/local-bin/.local/bin/dotfiles-doctor

set -uo pipefail

FIX=0
case "${1-}" in
  --fix) FIX=1 ;;
  -h | --help)
    sed -n '2,4p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  "") ;;
  *)
    echo "unknown argument: $1 (try --help)" >&2
    exit 2
    ;;
esac

# readlink resolves the stow symlink, so this finds the repo whether the script is called through
# ~/.local/bin or straight out of a fresh clone.
REPO=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd) || exit 1

if [[ -t 1 ]]; then
  R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' B=$'\e[1m' N=$'\e[0m'
else
  R= G= Y= B= N=
fi

problems=0
ok() { printf "  ${G}ok${N}    %s\n" "$*"; }
bad() {
  printf "  ${R}FAIL${N}  %s\n" "$*"
  problems=$((problems + 1))
}
warn() { printf "  ${Y}warn${N}  %s\n" "$*"; }
note() { printf '        %s\n' "$*"; }
section() { printf "\n${B}%s${N}\n" "$*"; }

# Print the repair, or run it under --fix.
repair() {
  if ((FIX)); then
    note "running: $*"
    eval "$@" 2>&1 | sed 's/^/        /'
  else
    note "fix: $*"
  fi
}

section "stow modules"
cd "$REPO" || exit 1
for mod in */; do
  mod=${mod%/}
  # A stow module holds dot-prefixed targets. Skips any plain directory added later.
  ls -A "$mod" | grep -q '^\.' || continue
  out=$(stow -n -v "$mod" 2>&1)
  rc=$?
  out=$(grep -v '^WARNING: in simulation mode' <<<"$out")
  if ((rc != 0)); then
    bad "$mod conflict"
    sed 's/^/        /' <<<"$out"
    note "resolve by hand (real file where a symlink belongs, usually an Omarchy migration), then: stow $mod"
  elif [[ -n $out ]]; then
    bad "$mod not stowed"
    repair "stow $mod"
  else
    ok "$mod"
  fi
done

section "packages"
missing=()
for pkg in git stow tmux tree-sitter-cli lazygit lazydocker usage mise starship alacritty mpv curl unzip; do
  pacman -Qq "$pkg" &>/dev/null || missing+=("$pkg")
done
if ((${#missing[@]})); then
  bad "not installed: ${missing[*]}"
  repair "sudo pacman -S --needed ${missing[*]}"
else
  ok "all declared packages installed"
fi

# tmux-sys-tools.sh opens the Docker window through Omarchy's wrapper rather than lazydocker directly:
# Omarchy 4 stopped granting the root-equivalent docker group, so the wrapper is what reaches the socket
# (pkexec, or straight through under sudoless Docker). It is an Omarchy internal, undocumented and marked
# hidden in its own menu metadata, on a 4.0.0.alpha that churns. A rename leaves the window dying at launch
# with nothing to read, so name the seam here instead.
if command -v omarchy-launch-docker-tui &>/dev/null; then
  ok "omarchy-launch-docker-tui"
else
  bad "omarchy-launch-docker-tui gone, the docker window in tmux-sys-tools.sh cannot open"
  note "Omarchy renamed or dropped the wrapper; point tmux-sys-tools.sh at whatever replaced it"
fi

section "mise tools"
if ! command -v mise &>/dev/null; then
  bad "mise not on PATH"
else
  # Lazy tools (Omarchy's /etc/mise/conf.d declarations) install on first use, so missing is fine.
  absent=$(mise ls --missing 2>/dev/null | grep -v '(lazy)')
  if [[ -n $absent ]]; then
    bad "declared tools not installed"
    sed 's/^/        /' <<<"$absent"
    repair "mise install"
  else
    ok "all declared tools installed"
  fi
  # config.toml postinstall hooks wire Neovim into each runtime. Silent no-ops when a hook fails.
  command -v neovim-ruby-host &>/dev/null && ok "ruby neovim gem" || {
    bad "ruby neovim gem"
    repair "mise exec ruby -- gem install neovim"
  }
  command -v neovim-node-host &>/dev/null && ok "node neovim package" || {
    bad "node neovim package"
    repair "mise exec node -- npm install -g neovim"
  }
  python -c 'import neovim' &>/dev/null && ok "python neovim package" || {
    bad "python neovim package"
    repair "mise exec python -- pip install neovim"
  }
fi

section "external installs"
TPM=$HOME/.local/share/tmux/plugins/tpm
if [[ -d $TPM ]]; then
  ok "tpm"
  absent=()
  while read -r plugin; do
    [[ $plugin == tpm ]] && continue
    [[ -d $HOME/.local/share/tmux/plugins/$plugin ]] || absent+=("$plugin")
  done < <(sed -n "s/.*@plugin '[^\/]*\/\([^']*\)'.*/\1/p" "$REPO/tmux/.config/tmux/tmux.conf")
  if ((${#absent[@]})); then
    bad "tmux plugins missing: ${absent[*]}"
    repair "$TPM/bin/install_plugins"
  else
    ok "tmux plugins"
  fi
else
  bad "tpm not installed"
  repair "git clone https://github.com/tmux-plugins/tpm $TPM"
fi

if [[ -d $HOME/.config/mpv/scripts/uosc ]]; then
  ok "uosc"
else
  bad "uosc not installed"
  repair "curl -fsSL https://raw.githubusercontent.com/tomasklaen/uosc/HEAD/installers/unix.sh | bash"
fi

LAZY=$HOME/.local/share/nvim/lazy
if [[ -d $LAZY ]]; then
  locked=$(grep -c '": {' "$REPO/lazyvim/.config/nvim/lazy-lock.json")
  installed=$(find "$LAZY" -maxdepth 1 -mindepth 1 -type d | wc -l)
  if ((installed < locked)); then
    warn "nvim plugins: $installed installed, $locked in lazy-lock.json"
    note "fix: nvim --headless '+Lazy! restore' +qa"
  else
    ok "nvim plugins ($installed)"
  fi
else
  bad "nvim plugins not installed"
  repair "nvim --headless '+Lazy! restore' +qa"
fi

section "input"
# input.lua carries no kb_layout/kb_variant; Omarchy's default derives both from /etc/vconsole.conf. That
# read is Omarchy code, not its documented interface (the manual says to hardcode in input.lua), and this is
# 4.0.0.alpha. If a release drops it, layout reverts to "us" silently. Same seam as omarchy issue #6878.
vc_layout=$(sed -n 's/^XKBLAYOUT=//p' /etc/vconsole.conf 2>/dev/null | tr -d '"')
vc_variant=$(sed -n 's/^XKBVARIANT=//p' /etc/vconsole.conf 2>/dev/null | tr -d '"')
live_layout=$(hyprctl getoption input:kb_layout 2>/dev/null | sed -n 's/^str: //p')

if [[ -z $live_layout ]]; then
  : # no Hyprland session to query, nothing to compare
elif grep -qE '^\s*kb_layout' "$REPO/hypr/.config/hypr/input.lua" 2>/dev/null; then
  ok "input.lua sets kb_layout directly, vconsole not in play"
elif [[ -z $vc_layout ]]; then
  bad "/etc/vconsole.conf has no XKBLAYOUT, so Omarchy falls back to us (omarchy issue #6878)"
  note "fix: sudo localectl set-x11-keymap <layout> <model> <variant> <options>"
else
  live_variant=$(hyprctl getoption input:kb_variant 2>/dev/null | sed -n 's/^str: //p')
  # Omarchy prepends a us group when the leading layout cannot type Latin, so accept that shape too.
  for pair in "layout:$live_layout:$vc_layout:us," "variant:$live_variant:$vc_variant:,"; do
    IFS=: read -r what live vc prefix <<<"$pair"
    if [[ $live == "$vc" || $live == "$prefix$vc" ]]; then
      ok "kb_$what ${live:-(empty)} matches vconsole"
    else
      bad "kb_$what is ${live:-(empty)}, vconsole says ${vc:-(empty)}"
      note "Omarchy may have dropped the vconsole read; set kb_$what in input.lua directly"
    fi
  done
fi

section "machine-local files"
SETTINGS=$HOME/.claude/settings.json
if [[ -L $SETTINGS ]]; then
  bad "~/.claude/settings.json is a symlink, so Claude Code writes into the module and private unlock refuses it"
  note "fix: replace with a real file, see the claude-code notes in CLAUDE.md"
elif [[ -f $SETTINGS ]]; then
  ok "~/.claude/settings.json"
else
  bad "~/.claude/settings.json absent"
  note "fix: ~/.private/private unlock, then re-add marketplaces"
fi

TERMS=$HOME/.config/xdg-terminals.list
if [[ -f $TERMS ]] && grep -qx 'Alacritty.desktop' "$TERMS"; then
  ok "default terminal is Alacritty"
else
  bad "default terminal not pinned, Omarchy launchers will open foot"
  repair "omarchy-default-terminal alacritty"
fi

# SUPER + B goes through `omarchy launch browser`, which opens Omarchy's default. Fresh install = chromium.
browser=$(omarchy-default-browser 2>/dev/null)
if [[ $browser == brave ]]; then
  ok "default browser is Brave"
else
  bad "default browser is ${browser:-unknown}, SUPER + B will not open Brave"
  repair "omarchy-default-browser brave"
fi

# Omarchy maps images to imv.desktop, which gets only the clicked file, so next/prev have nothing to step to.
# imv ships imv-dir.desktop for exactly this. Set in mimeapps.list, not by editing imv.desktop: Omarchy
# migrations re-run omarchy-refresh-applications, which copies its launchers over ~/.local/share/applications.
IMAGES="image/png image/jpeg image/gif image/webp image/bmp image/tiff"
wrong=()
for t in $IMAGES; do
  [[ $(xdg-mime query default "$t" 2>/dev/null) == imv-dir.desktop ]] || wrong+=("$t")
done
if ((${#wrong[@]})); then
  bad "${wrong[*]} not opening in imv-dir, next/prev image will not work"
  repair "xdg-mime default imv-dir.desktop $IMAGES"
else
  ok "images open in imv-dir"
fi

# Only us(intl) types ć on ' + c and needs the cedilla override. Global variant plus every keyboard's own:
# the notebook is plain br (real ç key) globally, but input.lua gives an external US keyboard us(intl) per
# device. Live Hyprland values first, vconsole when outside a session.
variant=$(hyprctl getoption input:kb_variant 2>/dev/null | sed -n 's/^str: //p')
[[ -z $variant ]] && variant=$(sed -n 's/^XKBVARIANT=//p' /etc/vconsole.conf 2>/dev/null | tr -d '"')
variant+=,$(hyprctl devices -j 2>/dev/null | jq -r '[.keyboards[].variant] | join(",")' 2>/dev/null)
if [[ ,$variant, == *,intl,* ]]; then
  # Effective table, not a file check: xkbcommon resolves ~/.XCompose and its includes the way fcitx5 does.
  # Capture first: grep -q exits on the hit, xkbcli dies on SIGPIPE and pipefail inverts the result.
  compose=$(xkbcli compile-compose 2>/dev/null)
  if grep -q '^<dead_acute> <c> *: *"ç"' <<<"$compose"; then
    ok "cedilla: ' + c types ç"
  else
    bad "cedilla: ' + c types ć"
    note "fix: see Cedilla with US keyboard layout in README.md"
  fi
fi

if ((problems)); then
  printf "\n${R}%d problem(s)${N}%s\n" "$problems" "$( ((FIX)) || echo ', re-run with --fix to apply the safe repairs')"
  exit 1
fi
printf "\n${G}all checks passed${N}\n"
