[user]
	name = Eugenio Augusto Jimenes
	email = eugeniojimenes@gmail.com
[color]
	ui = true
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[core]
	editor = nvim
[pull]
	rebase = true
[init]
	defaultBranch = develop
[commit]
	template = ~/dotfiles/git/.gitmessage
[merge]
	conflictStyle = zdiff3
[rebase]
	autoSquash = true
[push]
	followTags = true
[rerere]
	enabled = true
# Work identity: ~/.gitconfig-work, a symlink into ~/.private. Never in this public repo.
# Glob avoids naming the employer: matches ~/<something>-workspace/ only. Missing file = git ignores it.
[includeIf "gitdir:~/*-workspace/"]
	path = ~/.gitconfig-work
