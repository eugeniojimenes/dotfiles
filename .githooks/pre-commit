#!/usr/bin/env bash
# Refuse a commit that would publish a forbidden term or a secret. Local only, enabled per clone:
#   git config core.hooksPath .githooks      (dotfiles-doctor --fix sets it)
# Git runs hooks from the top of the work tree.

set -uo pipefail

failed=0

# Staged files and paths against the term list in ~/.private. Skipped, not failed, when the list is absent: CI, fresh
# clone. The commit message gets the same scan in commit-msg.
if ! out=$(bin/check terms --cached); then
  printf '%s\n' "$out"
  failed=1
fi

# Staged changes only. Pinned gitleaks through the flake when none is installed.
if command -v gitleaks >/dev/null; then
  gl=(gitleaks)
else
  gl=(nix shell --option warn-dirty false --inputs-from . nixpkgs#gitleaks -c gitleaks)
fi
"${gl[@]}" git --staged --redact --no-banner -v -l warn || failed=1

# Human doc staged without its pair: warning only, a typo fix in English needs no pt-br edit. Pairs:
# harness/rules/writing.md "Pairs". docs/specs/ is English only.
staged=$(git diff --cached --name-only)
while IFS= read -r f; do
  case $f in
    README.md) pair=README-pt-br.md ;;
    README-pt-br.md) pair=README.md ;;
    docs/*/*) continue ;;
    docs/*.pt-br.md | harness/README.pt-br.md) pair=${f%.pt-br.md}.md ;;
    docs/*.md | harness/README.md) pair=${f%.md}.pt-br.md ;;
    *) continue ;;
  esac
  [[ -f $pair ]] && ! grep -qxF "$pair" <<<"$staged" && echo "warning: $f staged without $pair" >&2
done <<<"$staged"

if ((failed)); then
  cat >&2 <<'MSG'

pre-commit: commit refused, a staged file or path holds a forbidden term or a secret (file:line above, value hidden).
If a tool wrote into a stowed file, such as an installer appending to ~/.bashrc, revert it: git checkout <file>
Otherwise remove the value, keep it outside this public repo and reference it by variable name.
MSG
  exit 1
fi
