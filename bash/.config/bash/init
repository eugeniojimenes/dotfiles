# Tool hooks. Completion and fzf key bindings (Ctrl-R, Ctrl-T, Alt-C) come from NixOS's /etc/bashrc
# (programs.fzf.keybindings in nixos/configuration.nix).
command -v mise &>/dev/null && eval "$(mise activate bash)"
command -v zoxide &>/dev/null && eval "$(zoxide init bash)"
[[ $TERM != dumb ]] && command -v starship &>/dev/null && eval "$(starship init bash --print-full-init)"
