#!/usr/bin/env bash
# Environment for interactive shells.

export EDITOR=nvim
export SUDO_EDITOR=nvim
# bat as pager for man pages; ansi theme follows the terminal palette.
export BAT_THEME=ansi
export MANROFFOPT=-c
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$PATH:$HOME/.local/bin" ;;
esac

# Private env vars live outside this public repo. Here, not in .bash_profile: Sway starts no login shell, so terminals
# would miss them. Guarded: a fresh machine has no ~/.private/envs yet. Replace with your own path.
# shellcheck source=/dev/null
[[ -f ~/.private/envs ]] && . ~/.private/envs
