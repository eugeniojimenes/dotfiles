**/undodir/**
**/backupdir/**
**/plugin/packer_compiled.lua
**/*.db
/.opencode/

# uosc ships own Lua tree plus ~17 MB prebuilt `ziggy` binaries (linux, darwin, windows .exe).
# No place in a public repo: no checksums, no provenance, two of three never run here.
# Install instead, see mpv/.config/mpv/README.md.
#
# script-opts/ ignored too: our uosc.conf held zero customizations, just upstream's stock
# default one version behind. Tracking it only froze a stale default, and the installer
# skips its own download when the file exists. Track it again if a setting actually changes.
# .uosc-backup is the installer's scratch dir, removed on success, left behind on a failure.
/mpv/.config/mpv/scripts/
/mpv/.config/mpv/fonts/
/mpv/.config/mpv/script-opts/
/mpv/.config/mpv/.uosc-backup/
