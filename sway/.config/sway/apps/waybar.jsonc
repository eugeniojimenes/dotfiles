{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": ["custom/menu", "sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/record",
    "custom/idle",
    "custom/nightlight",
    "custom/notifications",
    "tray",
    "network",
    "bluetooth",
    "wireplumber",
    "custom/display",
    "power-profiles-daemon",
    "battery"
  ],

  "custom/menu": {
    "format": "󱓞",
    "tooltip-format": "Menu (Super+Space)",
    "on-click": "~/.config/sway/bin/menu"
  },

  "sway/workspaces": { "disable-scroll": true },

  "clock": {
    "format": "{:L%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}",
    "on-click": "~/.config/sway/panels/calendar/toggle"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-disconnected": "Desconectado",
    "on-click": "~/.config/sway/panels/wifi/toggle"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "Bluetooth {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "on-click": "~/.config/sway/panels/bluetooth/toggle"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "{node_name}: {volume}%",
    "on-click": "~/.config/sway/panels/sound/toggle",
    "on-click-right": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower"
  },

  "custom/notifications": {
    "exec": "~/.config/sway/bin/dnd status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.config/sway/panels/notifications/toggle",
    "on-click-middle": "~/.config/sway/bin/dnd toggle"
  },

  "custom/idle": {
    "exec": "~/.config/sway/bin/idle status",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "~/.config/sway/bin/idle toggle"
  },

  "custom/nightlight": {
    "exec": "~/.config/sway/bin/nightlight status",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "on-click": "~/.config/sway/bin/nightlight toggle"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile} (click to change)",
    "format-icons": {
      "power-saver": "󰌪",
      "balanced": "󰗶",
      "performance": "󱐋"
    }
  },

  "custom/record": {
    "exec": "~/.config/sway/bin/record status",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.config/sway/bin/record stop"
  },

  "custom/display": {
    "format": "󰍹",
    "tooltip-format": "Displays: brightness, scale, text size",
    "on-click": "~/.config/sway/panels/display/toggle",
    "on-scroll-up": "swayosd-client --brightness raise && ~/.config/sway/panels/display/refresh",
    "on-scroll-down": "swayosd-client --brightness lower && ~/.config/sway/panels/display/refresh"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} (click for the power panel)",
    "states": { "warning": 25, "critical": 10 },
    "on-click": "~/.config/sway/panels/power/toggle"
  },

  "tray": { "spacing": 8 }
}
