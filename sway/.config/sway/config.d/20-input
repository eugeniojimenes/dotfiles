### Input. Every keyboard = us/intl, no layout toggle; a built-in ABNT2 gets br in its host file
# (hosts/loc-nixos). Variant inside the layout name: `xkb_variant intl` here would leak into the br override, which
# fails to compile (no br(intl)) and leaves the keyboard on us; sway's parser rejects xkb_variant "" to clear it.
# Identifiers: `swaymsg -t get_inputs`.
input type:keyboard {
    xkb_layout us(intl)
    xkb_options compose:caps,shift:both_capslock_cancel
    repeat_delay 600
    repeat_rate 40
}
input type:touchpad {
    tap enabled
    natural_scroll disabled
    scroll_factor 0.4
}
