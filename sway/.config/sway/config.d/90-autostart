### Autostart
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 330 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock' \
    after-resume '$dir/panels/display/reinit'
exec mako --config $dir/apps/mako
exec $dir/bin/wallpaper restore
# GTK4 without libadwaita: under the adw-gtk3-dark theme (set for GTK3 apps) its popup turns light. Default:dark =
# the dark look it had before.
exec env GTK_THEME=Default:dark swayosd-server
# Creates ~/Pictures, ~/Videos... and user-dirs.dirs when missing (fresh home). No-op otherwise.
exec xdg-user-dirs-update

exec $dir/bin/session-env

# Plain exec, not `bar { swaybar_command }`: that one runs without a shell, so ~ never expands and waybar
# silently never started.
exec waybar -c $dir/apps/waybar.jsonc -s $dir/apps/waybar.css >$XDG_RUNTIME_DIR/sway-waybar.log 2>&1
