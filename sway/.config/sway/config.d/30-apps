### Apps
#: Notification centre
bindsym $mod+Ctrl+comma exec $dir/panels/notifications/toggle
#: Dismiss notification popups (the centre keeps them)
bindsym $mod+Ctrl+period exec $dir/panels/notifications/clear popups
#: Clear all notifications
bindsym $mod+Ctrl+Shift+comma exec $dir/panels/notifications/clear all
#: Clipboard history
bindsym $mod+v exec $dir/bin/clipboard pick
#: Emoji picker
bindsym $mod+period exec $dir/bin/emoji
#: Terminal
bindsym $mod+Return exec $term
#: Tmux
bindsym $mod+Alt+Return exec $term -e $dir/bin/tmux-launch
#: Browser
bindsym $mod+b exec brave
#: Browser (private)
bindsym $mod+Shift+b exec brave --incognito
#: File manager
bindsym $mod+Shift+f exec nautilus
#: Editor
bindsym $mod+n exec $term -e nvim
# Single-window apps: focus the open window, else start it (bin/focus-or-run). Browsers open a new window each press.
#: System tools (btop + lazydocker)
bindsym $mod+Shift+t exec $dir/bin/focus-or-run sys-tools $term --class sys-tools -e $dir/bin/sys-tools
#: Music
bindsym $mod+m exec $dir/bin/focus-or-run spotify spotify
#: Slack
bindsym $mod+Shift+s exec $dir/bin/focus-or-run Slack slack
#: Menu: apps, settings and actions (again to close)
bindsym $mod+space exec $dir/panels/menu/toggle
#: Next wallpaper
bindsym $mod+Ctrl+space exec $dir/bin/wallpaper next
#: Previous wallpaper
bindsym $mod+Ctrl+Shift+space exec $dir/bin/wallpaper prev
#: Keybindings
bindsym $mod+k exec $dir/bin/keybindings
#: Lock screen
bindsym $mod+Shift+l exec $lock
