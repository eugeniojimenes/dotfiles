#!/usr/bin/env bash
# Keybindings cheat sheet, read live from the Sway config.
# Picking a line runs that binding's command, so it doubles as a launcher.

cfg=~/.config/sway/config

# Workspace bindcodes 10..19 = the number row keys 1..0.
awk '
  # Config variables ($term, $dir...) only exist inside the config: expand them so the command also runs via swaymsg.
  /^\s*set \$/ { name = $2; val = $0; sub(/^\s*set \S+\s+/, "", val); vars[name] = val; next }
  /^\s*bind(sym|code)/ {
    line = $0
    sub(/^\s*bind(sym|code)\s+/, "", line)
    while (line ~ /^--/) sub(/^--[a-z-]+\s+/, "", line)
    key = line; sub(/\s.*/, "", key)
    cmd = line; sub(/^\S+\s+/, "", cmd)
    for (pass = 0; pass < 2; pass++)   # twice: $lock expands to "$dir/lock/lock"
      for (v in vars) while ((i = index(cmd, v)) > 0) cmd = substr(cmd, 1, i - 1) vars[v] substr(cmd, i + length(v))
    if ($1 == "bindcode" && match(key, /\+?(1[0-9])$/)) {
      n = substr(key, RSTART + (substr(key, RSTART, 1) == "+")) - 9
      key = substr(key, 1, RSTART - 1 + (substr(key, RSTART, 1) == "+")) (n == 10 ? 0 : n)
    }
    gsub(/\$mod/, "Super", key); gsub(/Mod1/, "Alt", key); gsub(/\+/, " + ", key)
    label = cmd
    sub(/^exec\s+/, "", label)
    gsub(/~\/\.config\/sway\//, "", label)
    printf "%-34s %s\t%s\n", key, label, cmd
  }
' "$cfg" |
  fuzzel --dmenu --config ~/.config/sway/fuzzel.ini --width 80 --lines 14 \
    --font 'JetBrainsMono Nerd Font:size=10' --with-nth=1 --accept-nth=2 \
    --placeholder 'Keybindings' |
  { read -r cmd && swaymsg -q -- "$cmd"; }
