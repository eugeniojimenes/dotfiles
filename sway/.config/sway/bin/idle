#!/usr/bin/env bash
# Idle handling with swayidle. Spec: docs/specs/stay-awake.md.
#   idle start    normal: screensaver at 5 min, lock at 7 min, screens off at 7.5 min (sway autostart)
#   idle toggle   normal <-> stay awake (Super+Ctrl+I, menu Toggle, bar icon click)
#   idle status   JSON for the waybar module (signal 10): icon only while awake
# Awake = swayidle without timeouts, not no swayidle: suspend and lid close still lock first.

dir=~/.config/sway
lock=$dir/panels/lock/lock
saver=$dir/panels/screensaver/screensaver
normal=(timeout 300 "$saver start" resume "$saver stop" timeout 420 "$lock"
  timeout 450 'swaymsg "output * power off"' resume 'swaymsg "output * power on"')
always=(before-sleep "$lock" after-resume "$dir/panels/display/reinit")

# The awake instance is the only one whose first event is before-sleep.
awake() { pgrep -f '^swayidle -w before-sleep' >/dev/null; }

case ${1-} in
  start) exec swayidle -w "${normal[@]}" "${always[@]}" ;;
  toggle)
    if awake; then mode=("${normal[@]}") now=off; else mode=() now=on; fi
    pkill -x swayidle
    setsid -f swayidle -w "${mode[@]}" "${always[@]}" >/dev/null 2>&1
    # -f: NixOS runs waybar as .waybar-wrapped, see bin/dnd.
    pkill -RTMIN+10 -f '^waybar '
    # Popup: the bar icon alone gives no sign when it goes away.
    "${0%/*}/osd" switch awake "$now"
    ;;
  status)
    if awake; then
      echo '{"text": "󰅶", "tooltip": "Staying awake: no screensaver, lock or screen off when idle (click to allow)", "class": "awake"}'
    else
      echo '{"text": ""}'
    fi
    ;;
  *)
    sed -n '3,5p' "$0" | sed 's/^# \?//'
    exit 2
    ;;
esac
