#!/bin/sh
# Do not disturb for mako. `dnd toggle` from the menu/bar, `dnd share-on|share-off` from the screen-share hooks,
# `dnd record-on|record-off` from bin/record, `dnd status` for the waybar module. Every change pokes waybar (signal 8)
# instead of waybar polling.
case $1 in
  toggle) makoctl mode -t dnd >/dev/null ;;
  share-on) makoctl mode -a screenshare >/dev/null ;;
  share-off) makoctl mode -r screenshare >/dev/null ;;
  record-on) makoctl mode -a recording >/dev/null ;;
  record-off) makoctl mode -r recording >/dev/null ;;
  status)
    modes=$(makoctl mode)
    case $modes in
      *recording*) echo '{"text": "󰂛", "tooltip": "Notifications hidden: recording the screen", "class": "share"}' ;;
      *screenshare*) echo '{"text": "󰂛", "tooltip": "Notifications hidden: sharing the whole screen", "class": "share"}' ;;
      *dnd*) echo '{"text": "󰂛", "tooltip": "Do not disturb (click to turn off)", "class": "dnd"}' ;;
      *) echo '{"text": ""}' ;;
    esac
    exit 0
    ;;
esac
# -f on the command line: the NixOS wrapper renames the process to .waybar-wrapped, so -x waybar never matched.
pkill -RTMIN+8 -f '^waybar '
