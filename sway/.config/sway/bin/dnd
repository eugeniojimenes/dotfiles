#!/bin/sh
# Do not disturb for the notification daemon (panels/notifications.qml). `dnd toggle` from the menu/bar,
# `dnd share-on|share-off` from the screen-share hooks, `dnd record-on|record-off` from bin/record, `dnd status` for the
# waybar bell. Modes go over Quickshell IPC. Every change pokes waybar (signal 8) instead of waybar polling.
qs() { quickshell ipc -p ~/.config/sway/panels/notifications.qml call notifications "$@"; }
case $1 in
  toggle) qs modeToggle dnd >/dev/null ;;
  share-on) qs modeOn screenshare >/dev/null ;;
  share-off) qs modeOff screenshare >/dev/null ;;
  record-on) qs modeOn recording >/dev/null ;;
  record-off) qs modeOff recording >/dev/null ;;
  # The bell's JSON comes from the daemon (notify.mjs `bell`): mode, unread count. Daemon down: nothing to show.
  status)
    qs status 2>/dev/null || echo '{"text": ""}'
    exit 0
    ;;
esac
# -f on the command line: the NixOS wrapper renames the process to .waybar-wrapped, so -x waybar never matched.
pkill -RTMIN+8 -f '^waybar '
