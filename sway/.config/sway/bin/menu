#!/usr/bin/env bash
# Super+Space / bar icon. Categories with submenus, and every app listed under them, so typing
# an app name at the top level launches it directly. Esc in a submenu goes back up, Esc at the top closes.
# Lines = "label<TAB>action"; app lines add rofi-style icon metadata. fuzzel shows column 1, prints column 2.

dir=~/.config/sway

# Categories and their entries: a monochrome Nerd Font glyph in the label, no image icon. Only apps carry colored
# icons, so at a glance white = menu entry, color = app.
entry() { printf '%s  %s\t%s\n' "$1" "$2" "$3"; }

# Submenus use fuzzel-menu.ini, where Left exits with code 10 = back to the root.
pick() {
  local conf=$dir/apps/fuzzel.ini hint=
  [[ $level != root ]] && conf=$dir/apps/fuzzel-menu.ini hint='   ← back'
  local out rc
  out=$(fuzzel --dmenu --config "$conf" --with-nth=1 --accept-nth=2 --placeholder "$1$hint")
  rc=$?
  # custom-1 also prints the highlighted entry; on Left only "back" counts.
  if ((rc == 10)); then echo back; else printf '%s' "$out"; fi
}

apps() {
  local d f id dirs files=()
  declare -A seen
  # XDG data dirs, user dir first: a local .desktop overrides a later one with the same id. Not a fixed
  # /usr/share: NixOS keeps them under /run/current-system/sw/share and /etc/profiles/per-user, via XDG_DATA_DIRS.
  IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${dirs[@]}"; do files+=("$d"/applications/*.desktop); done
  for f in "${files[@]}"; do
    [[ -f $f ]] || continue
    id=${f##*/}
    [[ -n ${seen[$id]} ]] && continue
    seen[$id]=1
    awk -F= -v id="$id" '
      /^\[/ { main = ($0 == "[Desktop Entry]"); next }
      !main { next }
      # A TAB in Name would add a column: "App<TAB>run:cmd" would reach sh -c. Fields are TAB separated, so none in.
      $1 == "Name" && name == "" { name = substr($0, 6); gsub(/\t/, " ", name) }
      $1 == "Icon" { icon = substr($0, 6) }
      ($1 == "NoDisplay" || $1 == "Hidden") && $2 == "true" { hide = 1 }
      $1 == "Type" && $2 != "Application" { hide = 1 }
      END {
        if (name != "" && !hide)
          printf "%s\tapp:%s%cicon\037%s\n", name, id, 0, (icon == "" ? "application-x-executable" : icon)
      }
    ' "$f"
  done | sort -f
}

menu_root() {
  {
    entry 󰀻 "Apps  ›" menu:apps
    entry 󰌌 "Keybindings" "run:$dir/bin/keybindings"
    entry 󰂚 "Notifications" "run:$dir/panels/notifications/toggle"
    entry 󰅌 "Clipboard history" "run:$dir/bin/clipboard pick"
    entry 󰞅 "Emoji" "run:$dir/bin/emoji"
    entry 󰄀 "Capture  ›" menu:capture
    entry 󰏘 "Style  ›" menu:style
    entry 󰒓 "Setup  ›" menu:setup
    entry 󰔡 "Toggle  ›" menu:toggle
    entry 󰐥 "System  ›" menu:system
    apps
  } | pick 'Search apps and settings'
}

menu_apps() { apps | pick 'Apps'; }

menu_capture() {
  {
    entry 󰩭 "Screenshot (area)" "run:$dir/bin/screenshot area"
    entry 󰍹 "Screenshot (screen)" "run:$dir/bin/screenshot screen"
    entry 󰊄 "Text from area (OCR)" "run:$dir/bin/ocr"
    entry 󰈊 "Color picker" "run:$dir/bin/colorpick"
    # Any of these while recording stops it (bin/record).
    entry 󰑋 "Record area" "run:$dir/bin/record area"
    entry 󰑋 "Record screen" "run:$dir/bin/record screen"
    entry 󰍬 "Record area with microphone" "run:$dir/bin/record area audio"
    entry 󰍬 "Record screen with microphone" "run:$dir/bin/record screen audio"
  } | pick 'Capture'
}

menu_style() {
  {
    entry 󰸉 "Background" "run:$dir/bin/wallpaper pick"
    entry 󰒭 "Next background" "run:$dir/bin/wallpaper next"
    entry 󰃚 "Terminal opacity  ›" menu:opacity
  } | pick 'Style'
}

menu_opacity() {
  local cur v
  cur=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/sway/terminal-opacity" 2>/dev/null || echo 0.92)
  for v in 1.0 0.98 0.96 0.94 0.92 0.88 0.85 0.80; do
    entry "$([[ $v == "$cur" ]] && echo 󰄬 || echo 󰝦)" "$(awk -v v="$v" 'BEGIN { printf "%d%%", v * 100 }')" "run:$dir/bin/opacity $v"
  done | pick 'Terminal opacity'
}

menu_setup() {
  {
    entry 󰖩 "Wi-Fi" "run:$dir/panels/wifi/toggle"
    entry 󰂯 "Bluetooth" "run:$dir/panels/bluetooth/toggle"
    entry 󰕾 "Sound" "run:$dir/panels/sound/toggle"
    entry 󰍹 "Display" "run:$dir/panels/display/toggle"
    entry 󰁹 "Power" "run:$dir/panels/power/toggle"
    entry 󰏫 "Edit Sway config" "run:$dir/bin/float nvim $dir/config.d"
    entry 󰏫 "Edit bar" "run:$dir/bin/float nvim $dir/apps/waybar.jsonc"
    entry 󰑓 "Reload Sway" "run:swaymsg reload"
  } | pick 'Setup'
}

menu_toggle() {
  {
    entry 󰂛 "Do not disturb" "run:$dir/bin/dnd toggle"
    entry 󰅶 "Stay awake" "run:$dir/bin/idle toggle"
    entry 󰖔 "Night light" "run:$dir/bin/nightlight toggle"
    entry 󰾅 "Power profile  ›" menu:power
  } | pick 'Toggle'
}

# power-profiles-daemon; the waybar module follows the change over D-Bus by itself, bin/osd shows the popup.
menu_power() {
  local cur p
  cur=$(powerprofilesctl get 2>/dev/null)
  for p in power-saver balanced performance; do
    entry "$([[ $p == "$cur" ]] && echo 󰄬 || echo 󰝦)" "$p" "run:powerprofilesctl set $p && $dir/bin/osd switch profile $p"
  done | pick 'Power profile'
}

# Hibernation set up on this machine (resume device in nixos/hosts/<host>): Suspend hibernates later on battery, and
# Hibernate shows. /sys/power/resume reads 0:0 without it (the desktop has no swapfile).
hibernates() {
  local resume
  resume=$(cat "${SYS_POWER:-/sys/power}/resume" 2>/dev/null)
  [[ -n $resume && $resume != 0:0 ]]
}

menu_system() {
  # bin/update lives in the repo, not in a module: found through the stow link of this directory.
  local root
  root=$(readlink -f "$dir/../../..")
  {
    entry 󰚰 "Update" "run:$dir/bin/float $root/bin/update --pause"
    entry 󰌾 "Lock" "run:$dir/panels/lock/lock"
    entry 󰎟 "Clear clipboard history" "run:$dir/bin/clipboard clear"
    if hibernates; then
      entry 󰤄 "Suspend" "run:systemctl suspend-then-hibernate"
      entry 󰒲 "Hibernate" "run:systemctl hibernate"
    else
      entry 󰤄 "Suspend" "run:systemctl suspend"
    fi
    entry 󰍃 "Exit Sway" "run:swaymsg exit"
    entry 󰜉 "Reboot" "run:systemctl reboot"
    entry 󰐥 "Power off" "run:systemctl poweroff"
  } | pick 'System'
}

# Walk the tree: "menu:x" opens a submenu, "run:cmd" launches and ends. Esc in a submenu returns to the root.
level=root
while :; do
  choice=$("menu_$level")
  if [[ -z $choice ]]; then
    [[ $level == root ]] && exit 0
    level=root
    continue
  fi
  if [[ $choice == back* ]]; then
    level=root
    continue
  fi
  case $choice in
    menu:*) level=${choice#menu:} ;;
    # Apps by desktop id, handed to gtk-launch as one argument: a .desktop file name never reaches a shell.
    app:*)
      setsid -f gtk-launch "${choice#app:}" >/dev/null 2>&1
      exit 0
      ;;
    # Menu entries: commands written in this file, so running them through sh is fine.
    run:*)
      setsid -f sh -c "${choice#run:}" >/dev/null 2>&1
      exit 0
      ;;
  esac
done
